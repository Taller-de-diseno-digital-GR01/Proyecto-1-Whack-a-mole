flowchart TD

    subgraph UART["UART"]
        REG["Registro"]
    end

    subgraph FPGA["FPGA"]

        TOPO["Show_mole"]
        PRESS["Press_btn"]
        TIME["Time_Logic"]
        DECO["Deco UART"]
        FSM["FSM<br/>Máquina de Estados"]
        STATE["Estado de juego"]
        CA["Contador Acierto"<br/>Hit_Counter]
        C_F["Contador Fallo"<br/>Fail_Counter]
  

        CLK--> FSM
        rst--> FSM
        FSM -->|"pos_topo [7:0]"| TOPO
        PRESS -->|"btn [7:0]"| FSM
        FSM -->|"hit"| TIME
        FSM -->|"estado [1:0]"| STATE
        FSM -->|"acierto [6:0]"| CA
        FSM -->|"fallo [1:0]"| C_F
        DECO -->|"pos_topo [2:0]"| FSM  
        TIME -->|"UP"| FSM

    end
    REG -->|"pos[9:0]"| DECO
    BTN["Botones"]

    
    LED8["LED's Topos"]
    LED["LED estado"]
    MARK["Marcador"]
    
    TOPO -->|"pos_topo [7:0]"| LED8
    STATE -->|"estado"| LED
    CA -->|"acierto [6:0]"| MARK
    C_F -->|"fallo [1:0]"| MARK
    BTN -->|"btn [7:0]"| PRESS


    