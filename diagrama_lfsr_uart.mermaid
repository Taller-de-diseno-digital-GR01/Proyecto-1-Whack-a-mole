flowchart TD
    VCC(["VCC"])

    subgraph GEN[" "]
        CLK1["CLK<br/>555"]
        LFSR["LFSR"]
        DECO["Deco"]
        LEDS["LEDs"]

        CLK1 -->|CLK| LFSR
        LFSR -->|"pos [2:0]"| DECO
        DECO -->|"pos_topo [7:0]"| LEDS
    end

    subgraph UART["UART"]
        CLK2["CLK<br/>555"]
        REG["Registro"]

        CLK2 -->|"en"| REG
    end

    VCC --> GEN
    LFSR -->|"pos [2:0]"| REG
    REG --> FPGA["FPGA"]

    classDef verde fill:#000,stroke:#0c0,stroke-width:2px,color:#fff
    classDef rojo fill:#000,stroke:#c00,stroke-width:2px,color:#fff
    classDef libre fill:#000,stroke:#000,color:#fff

    class CLK1,CLK2,LFSR,DECO verde
    class LEDS,REG rojo
    class VCC,FPGA libre
